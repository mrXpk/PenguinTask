{
  "expo": {
    "name": "Penguin Task",
    "slug": "penguintask",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/art/icon.png",
    "scheme": "penguintask",
    "userInterfaceStyle": "light",
    "ios": { "bundleIdentifier": "com.pratap.penguintask", "supportsTablet": false },
    "android": {
      "package": "com.pratap.penguintask",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": { "foregroundImage": "./assets/art/icon.png", "backgroundColor": "#D5EEF6" },
      "predictiveBackGestureEnabled": true
    },
    "web": { "output": "static", "favicon": "./assets/art/icon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-notifications", { "color": "#328349" }],
      ["expo-splash-screen", { "backgroundColor": "#D5EEF6", "image": "./assets/art/checklist.png", "imageWidth": 160 }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
